{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POWER CHART AND BACKTEST",
  "mainBinaryName": "power-chart-and-backtest",
  "version": "1.3.0",
  "identifier": "com.powerchart.backtest",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "POWER CHART AND BACKTEST",
        "width": 1600,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "visible": false,
        "backgroundColor": "#0b0d10",
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,AutofillServerCommunication --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --disable-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost wss://fstream.binance.com wss://api.hyperliquid.xyz; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
